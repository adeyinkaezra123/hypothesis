/*
Hypothesis — inspect schema browser styling.

Kept in its own file (not an inline CSS string) so `textual run --dev
hypothesis.tui.inspect_app:InspectApp` hot-reloads visual edits live.
Colours come from the registered "hypothesis" theme, so tweak the palette
in inspect_app.py and the whole surface re-tints.
*/

Screen {
    layout: vertical;
}

Header {
    background: $panel;
}

HeaderTitle {
    text-style: bold;
}

/* The default glyph renders as tofu in some terminals; the title carries it. */
HeaderIcon {
    visibility: hidden;
}

#summary {
    /* Two text lines + 1-row bottom border + 1+1 vertical padding. */
    height: 5;
    padding: 1 2;
    background: $panel;
    border-bottom: heavy $primary;
}

#body {
    height: 1fr;
}

.pane-title {
    height: 1;
    padding: 0 2;
    margin: 0 0 1 0;
    text-style: bold;
    color: $accent;
}

#sidebar {
    width: 40;
    min-width: 30;
    padding: 1 0 0 0;
    background: $panel;
    border-right: heavy $primary-darken-2;
}

#search {
    height: 3;
    margin: 0 2 1 2;
    background: $surface;
    border: round $primary-darken-2;
}

#search:focus {
    border: round $accent;
}

#table-list {
    height: 1fr;
    padding: 0 1 1 1;
    background: transparent;
}

#table-list > ListItem {
    height: 3;
    padding: 0 1;
    margin: 0 0 1 0;
}

#table-list > ListItem > Label {
    width: 1fr;
}

#main {
    width: 1fr;
    padding: 1 0 0 0;
    background: $background;
}

#columns {
    height: 2fr;
    min-height: 8;
    margin: 0 2 1 2;
    background: $surface;
    border: round $primary-darken-2;
}

#columns:focus {
    border: round $accent;
}

#details-scroll {
    height: 1fr;
    min-height: 7;
    margin: 0 2 1 2;
    padding: 1 2;
    background: $surface;
    border: round $primary-darken-2;
}

#details {
    height: auto;
}

#empty {
    padding: 2;
    color: $text-muted;
}

ModalScreen {
    align: center middle;
    background: $background 60%;
}

#help-panel, #column-detail-scroll {
    width: 72;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $surface;
    border: round $accent;
}

#column-detail-scroll {
    width: 60;
}

#column-detail {
    height: auto;
}
